GMS_KEY="your_api_key"
AUTH_ENABLED="false"
# Format: token|scope1,scope2;token2|scope3
# Scopes used by this API:
# - ai:invoke
# - stt:invoke
# - rag:write
AUTH_TOKENS=""

# Embedding
DEFAULT_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
DEFAULT_EMBEDDING_BASE_URL="http://host.docker.internal:8001/v1"

# Qdrant
QDRANT_URL="http://host.docker.internal:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="interview_history"
QDRANT_VECTOR_SIZE="1024"
QDRANT_TIMEOUT_SECONDS="30.0"

# docker compose로 실행하면 fastapi 컨테이너는 host.docker.internal을 통해
# 호스트에서 실행 중인 임베딩 서버와 도커로 띄운 Qdrant에 접속합니다.
