def shouldSkip = false
def isSelfBuild = false
def feTestStatus = 'canceled'
def feBuildStatus = 'canceled'
def feDeployStatus = 'canceled'
pipeline {
	agent any

	options {
		gitLabConnection('GitLab_Codelian_AccessToken')
	}

	stages {
		// FE 파일 변동여부 체크
		stage('Check Frontend Changes') {
			steps {
				script {
					echo "--- 디버깅용 출력 ---"
					echo "gitlabSourceBranch: ${env.gitlabSourceBranch}"
					echo "gitlabActionType: ${env.gitlabActionType}"
					echo "gitlabMergeRequestState: ${env.gitlabMergeRequestState}"
					echo "gitlabMergeRequestIid : ${env.gitlabMergeRequestIid}"

					['FE-Test', 'FE-build', 'FE-deploy'].each { statusName ->
						updateGitlabCommitStatus name: statusName, state: 'pending'
					}
					isSelfBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0
					if(isSelfBuild) {
						echo "------- 💡 수동 빌드를 시작합니다. -------"
						shouldSkip = false
					} else {
						def targetBranch = env.gitlabTargetBranch ?: "develop"

						withCredentials([usernamePassword(credentialsId: 'gitlab-auth', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
							sh "git fetch https://${GIT_USERNAME}:${GIT_PASSWORD}@lab.ssafy.com/s14-ai-speech-sub1/S14P21A307.git ${targetBranch}"
						}

						def changedFiles = ""
						if(env.gitlabMergeRequestState == 'opened') {
							changedFiles = sh(
								script: "git diff --name-only FETCH_HEAD...HEAD",
								returnStdout: true
							).trim()
						} else {
							withCredentials([usernamePassword(credentialsId: 'gitlab-auth', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
								sh """
									git fetch https://${GIT_USERNAME}:${GIT_PASSWORD}@lab.ssafy.com/s14-ai-speech-sub1/S14P21A307.git ${targetBranch}
									git checkout ${targetBranch}
									git reset --hard FETCH_HEAD
								"""
							}
							changedFiles = sh(
								script: """
									MERGE_BASE=\$(git merge-base HEAD^1 HEAD^2)
									git diff --name-only \$MERGE_BASE HEAD^2 || git show --name-only --pretty=format:'' HEAD
								""",
								returnStdout: true
							).trim()
						}

						echo "--- 변경된 파일 목록 ---"
						echo changedFiles

						// FE 파일에 변동여부 체크
						def isFeChanged = changedFiles.split('\n').any {
							it.startsWith('fe/')
						}

						// 변동이 없으면 종료
						if (!isFeChanged) {
							echo "↩️ Frontend 변경사항 없음. 빌드를 종료합니다."
							shouldSkip = true
							feTestStatus = 'success'
							feBuildStatus = 'success'
							feDeployStatus = 'success'
						} else {
							echo "⏩ Frontend 변경 감지됨. 빌드 절차를 계속합니다."
							if(env.gitlabMergeRequestState == 'merged') {
								feTestStatus = 'success'
							}
						}
					}
				}
			}
		}

		// 환경변수
		stage('Prepare Env') {
			when {
				expression {
					return !shouldSkip
				}
			}
			steps {
				// Jenkins Credentials에서 .env 파일을 app에 복사시킴
				withCredentials([
					file(credentialsId: 'ENV_FILE', variable: 'ENV'),
				]) {
					sh 'cp $ENV infra/app/.env'
				}
			}
		}

		stage('FE Unit Test') {
			when {
				allOf {
					expression {
						return !shouldSkip
					}
					expression {
						env.gitlabMergeRequestState == 'opened' || isSelfBuild
					}
				}
			}
			steps {
				updateGitlabCommitStatus name: 'FE-Test', state: 'running'
				echo "------- 🧪 FE Unit Test 시작 -------"
				script {
					sh "docker rm -f fe-test-container || true"
					try {
						sh "docker build --memory=1g --memory-swap=2g --target builder -t fe-test-image ./fe --build-arg API_URL=https://j14a307.p.ssafy.io/api/v1"
						sh 'docker run --name fe-test-container -m 1g --memory-swap 2g fe-test-image pnpm test --watchAll=false'
					} finally {
						sh "docker rm -f fe-test-container || true"
					}
				}
			}
			post {
				success {
					script {
						feTestStatus = 'success'
					}
				}
				failure {
					script {
						feTestStatus = 'failed'
					}
				}
			}
		}

		// 프론트엔드 컨테이너 CI/CD
		stage('FE Continuous Integration (CI)') {
			when {
				allOf {
					expression {
						!shouldSkip
					}
					expression {
						env.gitlabMergeRequestState == 'merged' || isSelfBuild
					}
				}
			}
			steps {
				updateGitlabCommitStatus name: 'FE-build', state: 'running'
				echo "------- 🔅 Front-End 이미지 빌드 시작 -------"
				sh """
        		export COMPOSE_PROJECT_NAME=theinterview
				docker compose -f infra/app/app-compose.yml build frontend
				"""
			}
			post {
				success {
					script {
						feBuildStatus = 'success'
					}
				}
				failure {
					script {
						feBuildStatus = 'failed'
					}
				}
			}
		}
		stage('FE Continuous Deployment (CD)') {
			when {
				allOf {
					expression {
						!shouldSkip
					}
					expression {
						env.gitlabMergeRequestState == 'merged' || isSelfBuild
					}
				}
			}
			steps {
				updateGitlabCommitStatus name: 'FE-deploy', state: 'running'
				echo "------- 🔅 Front-End 컨테이너 배포 시작 -------"
				echo "------- ⤵️ Start Front-End container down... -------"
				sh """
					echo "------- 🔍 이미지 SHA 확인 -------"
					CONTAINER_IMAGE=\$(docker inspect frontend --format='{{.Image}}' 2>/dev/null || echo "컨테이너 없음")
					LATEST_IMAGE=\$(docker inspect theinterview-frontend:latest --format='{{.Id}}' 2>/dev/null || echo "이미지 없음")
					echo "현재 컨테이너 사용 이미지 SHA : \$CONTAINER_IMAGE"
					echo "현재 latest 이미지 SHA       : \$LATEST_IMAGE"
					if [ "\$CONTAINER_IMAGE" = "\$LATEST_IMAGE" ]; then
						echo "✅ 이미지 SHA 일치"
					else
						echo "⚠️ 이미지 SHA 불일치 - 컨테이너 재생성 필요"
					fi
				"""
				sh """
				docker ps -a --format "{{.Names}}" | grep "frontend" | xargs -r docker rm -f
				"""
				echo "------- ⤴️ Start Front-End container up... -------"
				sh """
				docker compose -f infra/app/app-compose.yml up -d --no-deps --force-recreate frontend
				"""
				sh """
					echo "------- 🔍 배포 후 이미지 SHA 재확인 -------"
					CONTAINER_IMAGE=\$(docker inspect frontend --format='{{.Image}}')
					LATEST_IMAGE=\$(docker inspect theinterview-frontend:latest --format='{{.Id}}')
					echo "현재 컨테이너 사용 이미지 SHA : \$CONTAINER_IMAGE"
					echo "현재 latest 이미지 SHA       : \$LATEST_IMAGE"
					if [ "\$CONTAINER_IMAGE" = "\$LATEST_IMAGE" ]; then
						echo "✅ 이미지 동기화 완료"
					else
						echo "❌ 이미지 동기화 실패"
						exit 1
					fi
				"""
			}
			post {
				success {
					script {
						feDeployStatus = 'success'
					}
				}
				failure {
					script {
						feDeployStatus = 'failed'
					}
				}
			}
		}
	}

	post {
		always {
			script {
				updateGitlabCommitStatus name: 'FE-Test', state: feTestStatus
				updateGitlabCommitStatus name: 'FE-build', state: feBuildStatus
				updateGitlabCommitStatus name: 'FE-deploy', state: feDeployStatus
			}
			echo '🚧 Cleaning up dangling images...'
			sh "docker image prune -f || true"
			sh "docker builder prune -f --keep-storage=5gb || true"
		}
		success {
			echo '✅ Deployment finished successfully!'
		}
		failure {
			echo '⚠️ Deployment failed. Check the logs.'
		}
	}
}