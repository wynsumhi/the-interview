def shouldSkip = false
pipeline {
	agent any

	stages {
		// BE 파일 변동여부 체크
		stage('Check Backend Changes') {
			steps {
				script {
					def changedFiles = sh(script: 'git diff --name-only HEAD~1', returnStdout: true).trim()
					echo "--- 변경된 파일 목록 ---"
					echo changedFiles
					echo "-----------------------"

					// BE 파일에 변동여부 체크
					def isBeChanged = changedFiles.split('\n').any {
						it.startsWith('be/')
					}

					// 변동이 없으면 종료
					if (!isBeChanged) {
						echo "↩️ Backend 변경사항 없음. 빌드를 종료합니다."
						shouldSkip = true
					} else {
						echo "⏩ Backend 변경 감지됨. 빌드 절차를 계속합니다."
					}
				}
			}
		}

		// 환경변수
		stage('Prepare Env') {
			when {
				expression {
					return !shouldSkip
				}
			}
			steps {
				// Jenkins Credentials에서 .env 파일을 app에 복사시킴
				withCredentials([
					file(credentialsId: 'ENV_FILE', variable: 'ENV'),
				]) {
					sh 'cp $ENV infra/app/.env'
				}
			}
		}

		// 백엔드 컨테이너 CI/CD
		stage('BE Continuous Integration (CI)') {
			when {
				expression {
					return !shouldSkip
				}
			}
			steps {
				echo "------- 🔅 Back-End 이미지 빌드 시작 -------"
				sh """
				export COMPOSE_PROJECT_NAME=theinterview
				docker compose -f infra/app/app-compose.yml build backend
				"""
			}
		}
		stage('BE Continuous Deployment (CD)') {
			when {
				expression{
					return !shouldSkip
				}
			}
			steps {
				echo "------- 🔅 Back-End 컨테이너 배포 시작 -------"
				echo "------- ⤵️ Start Back-End container down... -------"
				sh """
				docker ps -a --format "{{.Names}}" | grep "backend" | xargs -r docker rm -f
				"""
				echo "------- ⤴️ Start Back-End container up... -------"
				sh """
				docker compose -f infra/app/app-compose.yml up -d --no-deps backend
				"""
			}
		}
	}

	post {
		always {
			echo '🚧 Cleaning up dangling images...'
			sh "docker image prune -f"
		}
		success {
			echo '✅ Deployment finished successfully!'
		}
		failure {
			echo '⚠️ Deployment failed. Check the logs.'
		}
	}
}